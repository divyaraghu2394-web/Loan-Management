
@model LoanManagement.Core.ViewModels.EMICollectionViewModel

@{
    ViewData["Title"] = "EMI Collections";
    var currencyCulture = new System.Globalization.CultureInfo("en-IN");
}

<div class="container mt-4 mb-5">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <div>
            <h3 class="mb-1">EMI Collections</h3>
            <p class="text-muted mb-0">View customers and manage their EMI collections.</p>
        </div>
        @if (Model.Customer != null)
        {
            <a asp-controller="Dashboard"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Back to Customer Loans
            </a>
        }
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (Model.Customer == null)
    {
        <!-- Active Customer Grid -->

        <div class="card shadow-sm">

            <div class="card-header">
                <strong>Active Customers / Loans</strong>
            </div>

            <div class="card-body">

                @if (Model.ActiveLoans.Any())
                {
                    <div class="table-responsive">

                        <table class="table table-bordered table-hover align-middle">

                            <thead class="table-light">
                                <tr>
                                    <th>Photo</th>
                                    <th>Loan Account No.</th>
                                    <th>Customer Name</th>
                                    <th>Referred Person</th>
                                    <th>Contact No.</th>
                                    <th>Loan Amount</th>
                                    <th>EMI Amount</th>
                                    <th>Collected</th>
                                    <th>Remaining</th>
                                    <th>Total Pending</th>
                                    <th>Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var customer in Model.ActiveLoans)
                                {
                                    <tr>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(customer.PhotoPath))
                                            {
                                                <img src="@customer.PhotoPath"
                                                     alt="Customer Photo"
                                                     style="width:55px;height:55px;object-fit:cover;border-radius:50%;" />
                                            }
                                            else
                                            {
                                                <span class="text-muted">No Photo</span>
                                            }
                                        </td>

                                        <td>
                                            <strong>@customer.LoanAccountNo</strong>
                                        </td>

                                        <td>@customer.CustomerName</td>

                                        <td>
                                            @(string.IsNullOrWhiteSpace(customer.ReferredPerson)
                                                ? "-"
                                                : customer.ReferredPerson)
                                        </td>

                                        <td>
                                            @(string.IsNullOrWhiteSpace(customer.PrimaryContactNo)
                                                ? "-"
                                                : customer.PrimaryContactNo)
                                        </td>

                                        <td class="text-end">
                                            @customer.LoanAmount.ToString("N2")
                                        </td>

                                        <td class="text-end">
                                            @customer.EMIAmount.ToString("N2")
                                        </td>

                                        <td class="text-center text-success fw-bold">
                                            @customer.CollectedInstallments
                                        </td>

                                        <td class="text-center text-danger fw-bold">
                                            @customer.RemainingInstallments
                                        </td>

                                        <td class="text-end fw-bold">
                                            @customer.PendingAmount.ToString("N2")
                                        </td>

                                        <td>
                                            <form asp-controller="EMICollection"
                                                  asp-action="SearchLoan"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="LoanAccountNo"
                                                       value="@customer.LoanAccountNo" />

                                                <button type="submit"
                                                        class="btn btn-primary btn-sm text-nowrap">
                                                    Collect EMI
                                                </button>

                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">
                        No active customer loans found.
                    </p>
                }

            </div>
        </div>
    }
    else
    {
        <!-- Selected Customer Loan Details -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <strong>Customer Loan Details</strong>
            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-4 mb-3">
                        <label class="text-muted">Loan Account Number</label>
                        <div class="fw-bold">
                            @Model.Customer.LoanAccountNo
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="text-muted">Customer Name</label>
                        <div class="fw-bold">
                            @Model.Customer.CustomerName
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="text-muted">Loan Amount</label>
                        <div class="fw-bold">
                            @Model.Customer.LoanAmount.ToString("N2")
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="text-muted">EMI Amount</label>
                        <div class="fw-bold">
                            @Model.Customer.EMIAmount.ToString("N2")
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="text-muted">Total Installments</label>
                        <div class="fw-bold">
                            @Model.Customer.InstallmentCount
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="text-muted">Collected Installments</label>
                        <div class="fw-bold text-success">
                            @Model.CollectedInstallments
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="text-muted">Remaining Installments</label>
                        <div class="fw-bold text-danger">
                            @Model.RemainingInstallments
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="text-muted">Loan Status</label>
                        <div>
                            <span class="badge @(Model.IsLoanCompleted ? "bg-success" : "bg-primary")">
                                @(Model.IsLoanCompleted ? "Closed / Fully Paid" : "Active")
                            </span>
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="text-muted">Next Installment Number</label>
                        <div class="fw-bold @(Model.IsLoanCompleted ? "text-success" : "text-primary")">
                            @if (Model.IsLoanCompleted)
                            {
                                <span>Loan completed</span>
                            }
                            else
                            {
                                <span>#@Model.NextInstallmentNumber of @Model.Customer.InstallmentCount</span>
                            }
                        </div>
                        <small class="text-muted">
                            @(Model.IsLoanCompleted
                                ? "No further installment is due"
                                : "Next collection to be recorded")
                        </small>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="text-muted">Total Collected</label>
                        <div class="fw-bold text-success">
                            @Model.TotalCollectedAmount.ToString("N2")
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="text-muted">Total Penalty Collected</label>
                        <div class="fw-bold">
                            @Model.TotalPenaltyCollected.ToString("N2")
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="text-muted">Outstanding Amount</label>
                        <div class="fw-bold @(Model.OutstandingAmount == 0 ? "text-success" : "text-danger")">
                            @Model.OutstandingAmount.ToString("N2")
                        </div>
                    </div>

                </div>

            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header">
                <strong>Collect weekly EMI</strong>
            </div>
            <div class="card-body">
                @if (Model.IsLoanCompleted)
                {
                    <div class="alert alert-success mb-0">
                        This loan is closed and fully paid. All @Model.Customer.InstallmentCount installments have been collected. No further EMI is due.
                    </div>
                }
                else
                {
                    <form asp-controller="EMICollection"
                          asp-action="Collect"
                          method="post"
                          class="emi-collection-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="LoanAccountNo" />
                        <div class="row g-3 align-items-start">
                            <div class="col-12 col-md-4">
                                <label asp-for="InstallmentsToCollect" class="form-label"></label>
                                <select asp-for="InstallmentsToCollect" class="form-select">
                                    @for (int i = 1; i <= Model.RemainingInstallments; i++)
                                    {
                                        <option value="@i">@i installment@(i == 1 ? "" : "s") — @((Model.Customer.EMIAmount * i).ToString("C0", currencyCulture))</option>
                                    }
                                </select>
                                <span asp-validation-for="InstallmentsToCollect" class="text-danger"></span>
                                <small class="emi-field-note">&nbsp;</small>
                            </div>
                            <div class="col-12 col-md-3">
                                <label asp-for="CollectionDate" class="form-label"></label>
                                <input asp-for="CollectionDate" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" />
                                <small class="emi-field-note">&nbsp;</small>
                            </div>
                            <div class="col-12 col-md-3">
                                <label asp-for="PenaltyAmount" class="form-label"></label>
                                <input asp-for="PenaltyAmount" type="number" min="0" step="0.01" class="form-control" />
                                <small class="emi-field-note text-secondary">
                                    @(Model.IsPenaltyApplicable
                                        ? $"Overdue: suggested {Model.SuggestedPenaltyAmount.ToString("C0", currencyCulture)} per installment."
                                        : "Enter penalty only when applicable.")
                                </small>
                            </div>
                            <div class="col-12 col-md-2">
                                <label asp-for="PaymentMode" class="form-label"></label>
                                <select asp-for="PaymentMode" class="form-select">
                                    <option value="Cash">Cash</option>
                                    <option value="UPI">UPI</option>
                                    <option value="Bank Transfer">Bank Transfer</option>
                                    <option value="Cheque">Cheque</option>
                                    <option value="Other">Other</option>
                                </select>
                                <small class="emi-field-note">Reference is required for non-cash payments.</small>
                            </div>
                            <div class="col-12 col-md-4">
                                <label asp-for="PaymentReference" class="form-label"></label>
                                <input asp-for="PaymentReference" class="form-control" maxlength="100" />
                                <small class="emi-field-note">UPI/transaction/cheque number</small>
                            </div>
                            <div class="col-12 col-md-5">
                                <label asp-for="Remarks" class="form-label"></label>
                                <input asp-for="Remarks" class="form-control" maxlength="500" />
                                <small class="emi-field-note">Optional</small>
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label invisible" aria-hidden="true">Action</label>
                                <button type="submit" class="btn btn-primary w-100 text-nowrap">Collect EMI</button>
                                <small class="emi-field-note">&nbsp;</small>
                            </div>
                        </div>
                    </form>
                }
            </div>
        </div>

        <!-- EMI Collection History -->

        <div class="card shadow-sm">

            <div class="card-header">
                <strong>EMI Collection History</strong>
            </div>

            <div class="card-body">

                @{
                    var collectionEntries = Model.Collections
                        .Where(x => !x.IsReversalEntry)
                        .OrderBy(x => x.InstallmentNumber)
                        .ThenBy(x => x.CollectionId)
                        .ToList();
                }

                @if (collectionEntries.Any())
                {
                    <div class="table-responsive">

                        <table class="table table-bordered table-striped">

                            <thead class="table-light">
                                <tr>
                                    <th>Installment No.</th>
                                    <th>EMI Amount</th>
                                    <th>Penalty Amount</th>
                                    <th>Total Amount</th>
                                    <th>Collection Date</th>
                                    <th>Collected By</th>
                                    <th>Receipt</th>
                                    <th>Payment</th>
                                    <th>Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in collectionEntries)
                                {
                                    var rowClass = item.IsReversed ? "text-muted" : string.Empty;
                                    var amountClass = item.IsReversed ? "text-decoration-line-through" : string.Empty;
                                    <tr class="@rowClass">
                                        <td>@item.InstallmentNumber</td>
                                        <td class="@amountClass">@item.EMIAmount.ToString("N2")</td>
                                        <td class="@amountClass">@item.PenaltyAmount.ToString("N2")</td>
                                        <td class="@amountClass">@item.TotalAmount?.ToString("N2")</td>
                                        <td>@item.CollectionDate.ToString("dd-MMM-yyyy")</td>
                                        <td>@item.CreatedBy</td>
                                        <td>@(item.ReceiptNumber ?? "-")</td>
                                        <td>
                                            @item.PaymentMode
                                            @if (!string.IsNullOrWhiteSpace(item.PaymentReference))
                                            {
                                                <small class="d-block text-muted">@item.PaymentReference</small>
                                            }
                                        </td>
                                        <td>
                                            @if (item.IsReversed)
                                            {
                                                <span class="badge bg-warning text-dark">Reversed</span>
                                                @if (!string.IsNullOrWhiteSpace(item.ReversalReason))
                                                {
                                                    <small class="d-block text-muted">@item.ReversalReason</small>
                                                }
                                            }
                                            else if (Model.IsLoanCompleted || !Model.Customer.IsLive)
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-warning text-nowrap"
                                                        disabled
                                                        title="Reversal is disabled for closed loans.">
                                                    Reverse
                                                </button>
                                            }
                                            else
                                            {
                                                <form asp-controller="EMICollection"
                                                      asp-action="Reverse"
                                                      method="post"
                                                      onsubmit="return reverseCollection(this);">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="collectionId" value="@item.CollectionId" />
                                                    <input type="hidden" name="loanAccountNo" value="@Model.LoanAccountNo" />
                                                    <input type="hidden" name="reason" />
                                                    <button type="submit" class="btn btn-sm btn-outline-warning text-nowrap">Reverse</button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>

                    </div>

@section Scripts {
    <script>
        function reverseCollection(form) {
            const reason = window.prompt('Enter the reason for reversing this collection:');
            if (!reason || !reason.trim()) {
                return false;
            }

            form.querySelector('input[name="reason"]').value = reason.trim();
            return window.confirm('Reverse this collection? The original record will remain in the audit history.');
        }
    </script>
}
                }
                else
                {
                    <p class="text-muted mb-0">
                        No EMI collections recorded for this loan.
                    </p>
                }

            </div>
        </div>

    }

    @if (Model.Customer == null)
    {
        <div class="mt-3">
            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>
        </div>
    }

</div>
