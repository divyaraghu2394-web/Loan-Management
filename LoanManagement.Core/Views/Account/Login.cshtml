@model LoanManagement.Core.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Admin Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body class="login-page">
    <main class="login-shell">
        <section class="login-brand-panel">
            <div class="login-brand-content">
                <div class="login-logo"><span>L</span></div>
                <div class="login-brand-name">LoanDesk</div>
                <div class="login-brand-kicker">Loan operations platform</div>

                <div class="login-hero-copy">
                    <div class="login-eyebrow">CONTROL. CLARITY. GROWTH.</div>
                    <h1>Run your lending operation with confidence.</h1>
                    <p>One secure workspace for customer onboarding, loan servicing, and daily collections.</p>
                </div>

                <div class="login-feature-list">
                    <div><span class="login-feature-icon">✓</span> Centralized customer records</div>
                    <div><span class="login-feature-icon">✓</span> Clear daily collection visibility</div>
                    <div><span class="login-feature-icon">✓</span> Built for your operations team</div>
                </div>
            </div>
            <div class="login-glow login-glow-one"></div>
            <div class="login-glow login-glow-two"></div>
        </section>

        <section class="login-form-panel">
            <div class="login-form-container">
                <div class="login-mobile-brand">
                    <div class="login-logo"><span>L</span></div>
                    <div>
                        <div class="login-brand-name">LoanDesk</div>
                        <div class="login-brand-kicker">Loan operations platform</div>
                    </div>
                </div>

                <div class="login-heading">
                    <div class="login-eyebrow login-eyebrow-dark">ADMINISTRATOR ACCESS</div>
                    <h2>Welcome back</h2>
                    <p>Sign in to continue to your operations dashboard.</p>
                </div>

                <form asp-controller="Account" asp-action="Login" method="post" class="login-form">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="login-validation" role="alert"></div>

                    <div class="login-field">
                        <label asp-for="Username">Username</label>
                        <div class="login-input-wrap">
                            <span class="login-input-icon">◎</span>
                            <input asp-for="Username" placeholder="Enter your username" autocomplete="username" />
                            <span asp-validation-for="Username" class="login-field-error"></span>
                        </div>
                    </div>

                    <div class="login-field">
                        <label asp-for="Password">Password</label>
                        <div class="login-input-wrap">
                            <span class="login-input-icon">◆</span>
                            <input asp-for="Password" type="password" placeholder="Enter your password" autocomplete="current-password" />
                            <span asp-validation-for="Password" class="login-field-error"></span>
                        </div>
                    </div>

                    <button type="submit" class="login-submit">
                        <span>Sign in securely</span>
                        <span class="login-submit-arrow">→</span>
                    </button>
                </form>

                <div class="login-security-note">
                    <span>▣</span>
                    <span>Authorized administrators only</span>
                </div>
                <div class="login-footer">© @DateTime.UtcNow.Year LoanDesk · Secure operations workspace</div>
            </div>
        </section>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>
