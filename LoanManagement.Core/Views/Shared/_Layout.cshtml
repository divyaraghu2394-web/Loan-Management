<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LoanDesk</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-shell">
    <header class="app-header">
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container-fluid app-container">
                <a class="navbar-brand d-flex align-items-center gap-2"
                   asp-controller="Dashboard"
                   asp-action="Index">
                    <span class="brand-mark">L</span>
                    <span>
                        <strong class="d-block brand-name">LoanDesk</strong>
                        <small class="brand-subtitle">Operations platform</small>
                    </span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#appNavigation"
                        aria-controls="appNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="appNavigation">
                    <div class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        <a class="nav-link"
                           asp-controller="Dashboard"
                           asp-action="Index">Dashboard</a>
                        <a class="nav-link nav-link-action"
                           asp-controller="Customer"
                           asp-action="Register">
                            <span class="me-1">+</span> New Loan Application
                        </a>
                        <a class="nav-link"
                           asp-controller="EMICollection"
                           asp-action="Report">Reports</a>
                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              class="mt-2 mt-lg-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-light btn-sm px-3">
                                Sign out
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <main class="app-container py-4 py-lg-5">
        @RenderBody()
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
